{
  "name": "geonexo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev --scope=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^9.39.5",
    "playwright": "^1.63.0",
    "prettier": "^3.2.5",
    "turbo": "^1.13.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "globals": "^17.12.0"
  }
}