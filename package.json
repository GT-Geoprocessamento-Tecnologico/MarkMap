{
  "name": "markmap",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "esbuild@0.18.20": "0.25.12",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "verify:version": "node scripts/version-release-guard.mjs",
    "ci:local": "node scripts/local-ci.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^9.39.5",
    "playwright": "^1.63.0",
    "prettier": "^3.2.5",
    "turbo": "^2.9.14",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "globals": "^17.12.0"
  }
}
