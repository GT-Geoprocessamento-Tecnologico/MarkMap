{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "autoPort": true,
      "url": "http://localhost:5173"
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev", "--filter", "services/api"],
      "port": 3000,
      "url": "http://localhost:3000"
    }
  ]
}
