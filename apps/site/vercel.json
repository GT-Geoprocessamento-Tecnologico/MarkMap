{
  "redirects": [
    {
      "source": "/app",
      "destination": "https://appmarkmap.mtsferreira.dev/",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "https://appmarkmap.mtsferreira.dev/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://appmarkmap.mtsferreira.dev/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!site-assets/|favicon.svg|manifest.json|sw.js|favicon.ico|robots.txt|app(?:/|$)|assets/|icons/|fonts/|shell-manifest.json).*)",
      "destination": "/index.html"
    }
  ]
}
