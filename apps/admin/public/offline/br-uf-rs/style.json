{
  "version": 8,
  "name": "MarkMap Araguaína geometry-only",
  "sources": {
    "basemap": { "type": "vector", "url": "pmtiles://package.pmtiles" }
  },
  "layers": [
    {
      "id": "earth",
      "type": "fill",
      "source": "basemap",
      "source-layer": "earth",
      "paint": { "fill-color": "#e8eadf" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "paint": { "fill-color": "#dce8d4", "fill-opacity": 0.7 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "paint": { "fill-color": "#e9e5d8", "fill-opacity": 0.55 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": { "fill-color": "#a9d8e8" }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 11,
      "paint": {
        "fill-color": "#d7d1c5",
        "fill-opacity": 0.8,
        "fill-outline-color": "#b8b0a2"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "paint": {
        "line-color": "#8f8b82",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 12, 3]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#8a7f70",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    }
  ]
}
