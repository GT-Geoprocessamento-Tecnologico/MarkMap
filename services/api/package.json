{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "hono dev",
    "build": "esbuild src/server.ts --bundle --external:@hono/* --external:drizzle-orm --external:postgres --external:zod --external:hono --external:@aws-sdk/* --platform=node --target=node20 --format=esm --outdir=dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@markmap/contracts": "workspace:*",
    "@markmap/db": "workspace:*",
    "@hono/node-server": "2.1.3",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.11",
    "postgres": "^3.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@markmap/config": "workspace:*",
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.12"
  }
}
